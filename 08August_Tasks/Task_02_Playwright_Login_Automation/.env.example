# ============================================================
# Wingify Login Automation - Environment Template
# ============================================================
# Copy this file to .env and fill in the values.
# .env is git-ignored - credentials never enter version control.

# Application under test
BASE_URL=https://app.wingify.com

# Test data - VALID credentials (session-stored, never hardcoded in specs)
VALID_USERNAME= "opg73@singleuseemail.site"
VALID_PASSWORD= "Wingify@4321"

# Test data - INVALID credentials
INVALID_USERNAME= "invalid.user@example.com"
INVALID_PASSWORD= "WrongPass@123"

# Validation messages
INVALID_CREDENTIALS_MESSAGE=

# Email used for forgot-password flow
FORGOT_PASSWORD_EMAIL=

# CI/CD flags
CI=false

# Headless mode toggle (true/false)
HEADLESS=true

# Playwright reporter: list, html, allure
REPORTER=allure
