# Copy to .env and fill in. Never commit .env.
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=            # id.atlassian.com -> Security -> API tokens
GROQ_API_KEY=              # console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
JIRA_AC_FIELD=             # optional: Acceptance Criteria custom field id, e.g. customfield_10042
                           # discover with: py tools/verify_link.py  (reports acceptance-related fields)
DEFAULT_JIRA_KEY=          # optional: a default issue key, e.g. SAM1-1
